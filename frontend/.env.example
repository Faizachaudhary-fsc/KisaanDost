# KisaanDost API Configuration Example
# Copy this file to .env and fill in your backend's actual address.

# Backend API base URL (without trailing slash). Leave blank for web or the
# Android emulator default (http://10.0.2.2:8000).
# Physical Android device: set this to the Windows PC LAN IPv4 address, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
# ngrok tunnel: https://abc123.ngrok.io (example)
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.105:8000

# Keep false to use the FastAPI backend. Set true only for offline mock UI work.
USE_MOCK=false


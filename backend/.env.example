# Copy to .env and fill in local secrets. Never commit the real values.
MONGODB_URI=
MONGODB_DB_NAME=kisaandost
CORS_ORIGINS=*
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
OMNI_BASE_URL=
OMNI_MODEL=qwen3.5-omni-plus
OMNI_VOICE=Tina
ASR_ENABLED=true

# ── Google Gemini voice assistant ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Groq Whisper Urdu speech-to-text
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Legacy Alibaba settings are unused by the voice assistant.

# Azure Speech supports Urdu Pakistan recognition and neural synthesis.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=ur-PK
AZURE_SPEECH_VOICE=ur-PK-UzmaNeural